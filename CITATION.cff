    given-names: Biprateep
    affiliation: University of Toronto
    orcid: "https://orcid.org/0000-0002-5665-7912"
  - family-names: Speagle
    given-names: Joshua Shen
    affiliation: University of Toronto
    orcid: "https://orcid.org/0000-0003-2573-9832"
# The concept DOI: every version of lazy-tfm on Zenodo; it resolves to the
# latest release.
doi: 10.5281/zenodo.23751881
identifiers:
