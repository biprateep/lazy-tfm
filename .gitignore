# This branch tracks only the Python sources, the environment (pyproject.toml,
# uv.lock) and the final figures. Every intermediate data product is
# regenerated by running the scripts, and never committed.

# Environments: .venv holds the foundation models, .venv-rail the RAIL
# baselines (see README.md).
.venv/
.venv-*/

# Intermediate data products: downloaded catalogues, frozen splits, model
# outputs, per-run records, tables and logs.
results/
data/
logs/
*.npz
*.npy
*.h5
*.hdf5
*.pkl
*.parquet
*.fits
*.csv
*.json
*.log

# Notebooks are authored as py:percent scripts; the paired .ipynb is a
# by-product.
*.ipynb
.ipynb_checkpoints/

# Python and tool caches.
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Quick-look figures; the paper's final figures live in figures/.
analysis/figs/
